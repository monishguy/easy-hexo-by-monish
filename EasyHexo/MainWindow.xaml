<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EasyHexo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:EasyHexo.Localization">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏：跟随明暗主题，右侧留给系统的最小化 / 最大化 / 关闭按钮 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon
                    Glyph="&#xE7C3;"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    x:Name="AppTitleText"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    l:Trans.Text="app.title" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneDisplayMode="Auto"
            CompactPaneLength="48"
            OpenPaneLength="248"
            ExpandedModeThresholdWidth="1260"
            CompactModeThresholdWidth="800"
            IsPaneOpen="True"
            PaneOpened="OnNavPaneChanged"
            PaneClosed="OnNavPaneChanged"
            DisplayModeChanged="OnNavDisplayModeChanged"
            SelectionChanged="OnNavSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavConfig" Tag="config" l:Trans.Content="nav.config">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE70F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavPublish" Tag="publish" l:Trans.Content="nav.publish">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE898;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavSettings" Tag="settings" l:Trans.Content="nav.settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <!-- 只在侧栏展开（或窗口足够宽）时显示；收起为图标栏时隐藏 -->
                <StackPanel x:Name="RootInfoPanel" Margin="12,8,12,16" Spacing="2">
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        l:Trans.Text="root.current"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        x:Name="RootPathText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid>
                <Frame x:Name="ContentFrame" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
