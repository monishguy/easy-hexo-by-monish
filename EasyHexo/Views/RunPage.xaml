<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EasyHexo.Views.RunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:EasyHexo.Localization">

    <Grid Margin="20,14,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 + 工作目录 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" Margin="0,0,12,0">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" l:Trans.Text="run.title" />
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    l:Trans.Text="run.subtitle" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" MaxWidth="460">
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    l:Trans.Text="run.workingDir" />
                <TextBlock
                    x:Name="WorkDirText"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    IsTextSelectionEnabled="True" />
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="1"
            IsOpen="False"
            IsClosable="True"
            Margin="0,0,0,8" />

        <!-- 命令按钮 + 带参数命令 -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
            <StackPanel Spacing="10">
                <ContentControl x:Name="CommandHost" IsEnabled="False" HorizontalContentAlignment="Stretch">
                <Grid x:Name="CommandGrid" ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" Click="OnGenerateClick" l:Trans.Content="run.generate" />
                    <Button Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Click="OnCleanClick" l:Trans.Content="run.clean" />
                    <Button Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch" Click="OnServerClick" l:Trans.Content="run.server" />
                    <Button Grid.Row="0" Grid.Column="3" HorizontalAlignment="Stretch" Click="OnDeployClick" l:Trans.Content="run.deploy" />

                    <Button Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" Click="OnGenerateDeployClick" l:Trans.Content="run.generateDeploy" />
                    <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Click="OnGenerateForceClick" l:Trans.Content="run.generateForce" />
                    <Button Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" Click="OnGenerateWatchClick" l:Trans.Content="run.generateWatch" />
                    <Button Grid.Row="1" Grid.Column="3" HorizontalAlignment="Stretch" Click="OnListPostsClick" l:Trans.Content="run.listPosts" />

                    <Button Grid.Row="2" Grid.Column="0" HorizontalAlignment="Stretch" Click="OnVersionClick" l:Trans.Content="run.version" />
                </Grid>
                </ContentControl>

                <ContentControl x:Name="ParamHost" IsEnabled="False" HorizontalContentAlignment="Stretch">
                <Grid x:Name="ParamGrid" ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" l:Trans.Text="run.newPost" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="NewPostBox" MinHeight="32" l:Trans.Placeholder="run.newPostHint" />
                    <Button Grid.Row="0" Grid.Column="2" Click="OnNewPostClick" l:Trans.Content="run.newPost" />

                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" l:Trans.Text="run.newPage" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="NewPageBox" MinHeight="32" l:Trans.Placeholder="run.newPageHint" />
                    <Button Grid.Row="1" Grid.Column="2" Click="OnNewPageClick" l:Trans.Content="run.newPage" />

                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" l:Trans.Text="run.publishDraft" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="DraftBox" MinHeight="32" l:Trans.Placeholder="run.publishDraftHint" />
                    <Button Grid.Row="2" Grid.Column="2" Click="OnPublishDraftClick" l:Trans.Content="run.publishDraft" />
                </Grid>
                </ContentControl>

                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    l:Trans.Text="run.serverHint" />
            </StackPanel>
        </Border>

        <!-- 输出 -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        VerticalAlignment="Center"
                        l:Trans.Text="run.output" />
                    <ProgressRing
                        x:Name="BusyRing"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        Width="18"
                        Height="18"
                        IsActive="False"
                        Visibility="Collapsed"
                        VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="RunStatusText"
                        Grid.Column="2"
                        Margin="10,0,8,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        x:Name="StopButton"
                        Grid.Column="3"
                        Margin="0,0,8,0"
                        Click="OnStopClick"
                        IsEnabled="False"
                        l:Trans.Content="run.stop" />
                    <Button Grid.Column="4" Click="OnClearOutputClick" l:Trans.Content="run.clear" />
                </Grid>

                <TextBox
                    x:Name="OutputBox"
                    Grid.Row="1"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    FontFamily="Consolas"
                    FontSize="12"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    IsSpellCheckEnabled="False"
                    AutomationProperties.AutomationId="RunOutput" />
            </Grid>
        </Border>
    </Grid>
</Page>
