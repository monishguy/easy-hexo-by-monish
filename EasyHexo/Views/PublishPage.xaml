<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EasyHexo.Views.PublishPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:EasyHexo.Localization"
    xmlns:m="using:EasyHexo.Models">

    <Grid
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop"
        Margin="24,16,24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：已发布文章（修改日期新到旧） -->
        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        VerticalAlignment="Center"
                        l:Trans.Text="publish.posts" />
                    <Button
                        Grid.Column="1"
                        Padding="6"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnRefreshPostsClick"
                        l:Trans.ToolTip="common.refresh">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    </Button>
                </Grid>

                <ListView
                    x:Name="PostsListView"
                    Grid.Row="1"
                    ItemsSource="{x:Bind Posts}"
                    SelectionMode="Single"
                    SelectionChanged="OnPostSelectionChanged"
                    AutomationProperties.AutomationId="PostsList"
                    ItemContainerStyle="{StaticResource PostListItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="m:ArticleInfo">
                            <StackPanel Spacing="2" Padding="0,2,0,2">
                                <TextBlock
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis"
                                    Style="{StaticResource BodyTextBlockStyle}" />
                                <TextBlock
                                    Text="{x:Bind ModifiedText}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    x:Name="PostsCountText"
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

        <!-- 右：编辑器 -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <StackPanel Spacing="2">
                    <TextBlock
                        Style="{StaticResource TitleTextBlockStyle}"
                        l:Trans.Text="publish.title" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        l:Trans.Text="publish.subtitle" />
                </StackPanel>

                <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />

                <!-- 拖放 / 浏览文件 -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Glyph="&#xE898;"
                            FontSize="20"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                        <StackPanel Grid.Column="1" Margin="12,0,12,0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock TextWrapping="Wrap" l:Trans.Text="publish.dropHint" />
                            <TextBlock
                                x:Name="SourcePathText"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OnBrowseClick"
                                l:Trans.Content="publish.browse" />
                            <Button Click="OnClearClick" l:Trans.Content="common.clear" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock
                    x:Name="QueueText"
                    Visibility="Collapsed"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- 文章信息 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            l:Trans.Text="publish.info" />

                        <TextBox x:Name="TitleBox" l:Trans.Header="publish.titleField" TextChanged="OnTitleTextChanged" AutomationProperties.AutomationId="TitleBox" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DatePicker
                                x:Name="DateSelector"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                MinWidth="280"
                                l:Trans.Header="publish.dateField" />
                            <TimePicker
                                x:Name="TimeSelector"
                                Grid.Column="2"
                                HorizontalAlignment="Left"
                                MinWidth="180"
                                ClockIdentifier="24HourClock"
                                l:Trans.Header="publish.timeField" />
                        </Grid>

                        <TextBox
                            x:Name="TagInput"
                            AutomationProperties.AutomationId="TagInput"
                            l:Trans.Header="publish.tagsField"
                            l:Trans.Placeholder="publish.tagsPlaceholder"
                            KeyDown="OnTagInputKeyDown" />

                        <ItemsControl x:Name="TagsList" ItemsSource="{x:Bind Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:TagItem">
                                    <Border
                                        Margin="0,4,6,0"
                                        Padding="10,2,4,2"
                                        CornerRadius="10"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock
                                                Text="{x:Bind Name}"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource CaptionTextBlockStyle}" />
                                            <Button
                                                Width="18"
                                                Height="18"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="9"
                                                Click="OnRemoveTagClick">
                                                <FontIcon Glyph="&#xE711;" FontSize="8" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 资源处理说明 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            l:Trans.Text="publish.assets" />
                        <TextBlock
                            x:Name="AssetsInfoText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 发布 -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                    <Button
                        x:Name="PublishButton"
                        Style="{StaticResource AccentButtonStyle}"
                        MinWidth="150"
                        AutomationProperties.AutomationId="PublishButton"
                        Click="OnPublishClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="BusyRing" IsActive="False" Width="16" Height="16" />
                            <TextBlock l:Trans.Text="publish.button" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        l:Trans.Text="publish.editHint" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
