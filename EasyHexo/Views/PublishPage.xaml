<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EasyHexo.Views.PublishPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:EasyHexo.Localization"
    xmlns:m="using:EasyHexo.Models">

    <Grid
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop"
        Margin="20,14,20,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：待发布（导入的文章）+ 已发布文章 -->
        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 分类：筛选 + 管理 -->
                <Grid Grid.Row="0" Margin="0,0,0,8" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        l:Trans.Text="publish.categoryLabel" />
                    <ComboBox
                        x:Name="CategoryFilterCombo"
                        Grid.Column="1"
                        MinWidth="90"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="CategoryFilterCombo"
                        SelectionChanged="OnCategoryFilterChanged" />
                    <Button
                        Grid.Column="2"
                        Padding="8,4"
                        FontSize="12"
                        Click="OnNewCategoryClick"
                        AutomationProperties.AutomationId="NewCategoryButton"
                        l:Trans.Content="publish.categoryNew" />
                    <Button
                        Grid.Column="3"
                        Padding="8,4"
                        FontSize="12"
                        Click="OnDeleteCategoryClick"
                        AutomationProperties.AutomationId="DeleteCategoryButton"
                        l:Trans.Content="publish.categoryDelete" />
                </Grid>

                <!-- 待发布 -->
                <Grid Grid.Row="1" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        VerticalAlignment="Center"
                        l:Trans.Text="publish.drafts" />
                    <TextBlock
                        x:Name="DraftsCountText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <ListView
                    x:Name="DraftListView"
                    Grid.Row="2"
                    MaxHeight="170"
                    ItemsSource="{x:Bind Drafts}"
                    SelectionMode="Single"
                    SelectionChanged="OnDraftSelectionChanged"
                    AutomationProperties.AutomationId="DraftList"
                    ItemContainerStyle="{StaticResource PostListItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="m:ImportDraft">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" Padding="0,2,0,2">
                                    <TextBlock
                                        Text="{x:Bind DisplayTitle}"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource BodyTextBlockStyle}" />
                                    <TextBlock
                                        Text="{x:Bind DisplaySubtitle}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextTrimming="CharacterEllipsis"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalAlignment="Center"
                                    Click="OnRemoveDraftClick"
                                    l:Trans.ToolTip="publish.removeDraft">
                                    <FontIcon Glyph="&#xE711;" FontSize="10" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    x:Name="DraftsEmptyText"
                    Grid.Row="2"
                    Margin="4,2,4,2"
                    TextWrapping="Wrap"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    l:Trans.Text="publish.draftsEmpty" />

                <Border
                    Grid.Row="4"
                    Height="1"
                    Margin="0,8,0,8"
                    Background="{ThemeResource ControlStrokeColorDefaultBrush}" />

                <!-- 已发布文章 -->
                <Grid Grid.Row="5" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        VerticalAlignment="Center"
                        l:Trans.Text="publish.posts" />
                    <Button
                        Grid.Column="1"
                        Padding="6"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnRefreshPostsClick"
                        l:Trans.ToolTip="common.refresh">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    </Button>
                </Grid>

                <ListView
                    x:Name="PostsListView"
                    Grid.Row="6"
                    ItemsSource="{x:Bind Posts}"
                    SelectionMode="Single"
                    SelectionChanged="OnPostSelectionChanged"
                    AutomationProperties.AutomationId="PostsList"
                    ItemContainerStyle="{StaticResource PostListItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="m:ArticleInfo">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    MinWidth="0"
                                    VerticalAlignment="Center"
                                    IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                    AutomationProperties.AutomationId="{x:Bind CheckAutomationId}"
                                    Checked="OnPostCheckChanged"
                                    Unchecked="OnPostCheckChanged" />
                                <StackPanel Grid.Column="1" Spacing="2" Padding="0,2,0,2">
                                    <TextBlock
                                        Text="{x:Bind Title}"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource BodyTextBlockStyle}" />
                                    <TextBlock
                                        Text="{x:Bind ModifiedText}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        Text="{x:Bind CategoryDisplay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    x:Name="PostsCountText"
                    Grid.Row="7"
                    Margin="0,8,0,0"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

        <!-- 右：编辑器 -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <StackPanel Spacing="2">
                    <TextBlock
                        Style="{StaticResource TitleTextBlockStyle}"
                        l:Trans.Text="publish.title" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        l:Trans.Text="publish.subtitle" />
                </StackPanel>

                <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />

                <!-- 拖放 / 浏览文件 -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Glyph="&#xE898;"
                            FontSize="20"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                        <StackPanel Grid.Column="1" Margin="12,0,12,0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock TextWrapping="Wrap" l:Trans.Text="publish.dropHint" />
                            <TextBlock
                                x:Name="SourcePathText"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OnBrowseClick"
                                AutomationProperties.AutomationId="BrowseArticleButton"
                                l:Trans.Content="publish.browse" />
                            <Button Click="OnClearClick" l:Trans.Content="common.clear" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 文章信息 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            l:Trans.Text="publish.info" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                l:Trans.Text="publish.categoryLabel" />
                            <ComboBox
                                x:Name="ArticleCategoryCombo"
                                Grid.Column="1"
                                MinWidth="180"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="ArticleCategoryCombo"
                                SelectionChanged="OnArticleCategoryChanged" />
                        </Grid>

                        <TextBox x:Name="TitleBox" l:Trans.Header="publish.titleField" TextChanged="OnTitleTextChanged" AutomationProperties.AutomationId="TitleBox" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DatePicker
                                x:Name="DateSelector"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                MinWidth="280"
                                l:Trans.Header="publish.dateField" />
                            <TimePicker
                                x:Name="TimeSelector"
                                Grid.Column="2"
                                HorizontalAlignment="Left"
                                MinWidth="180"
                                ClockIdentifier="24HourClock"
                                l:Trans.Header="publish.timeField" />
                        </Grid>

                        <TextBox
                            x:Name="TagInput"
                            AutomationProperties.AutomationId="TagInput"
                            l:Trans.Header="publish.tagsField"
                            l:Trans.Placeholder="publish.tagsPlaceholder"
                            KeyDown="OnTagInputKeyDown" />

                        <ItemsControl x:Name="TagsList" ItemsSource="{x:Bind Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:TagItem">
                                    <Border
                                        Margin="0,4,6,0"
                                        Padding="10,2,4,2"
                                        CornerRadius="10"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock
                                                Text="{x:Bind Name}"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource CaptionTextBlockStyle}" />
                                            <Button
                                                Width="18"
                                                Height="18"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="9"
                                                Click="OnRemoveTagClick">
                                                <FontIcon Glyph="&#xE711;" FontSize="8" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 资源文件处理 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            l:Trans.Text="publish.assetsTitle" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            l:Trans.Text="publish.assetsHint" />

                        <TextBlock
                            x:Name="AssetsEmptyText"
                            Visibility="Collapsed"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            l:Trans.Text="publish.assetsNone" />

                        <ItemsControl x:Name="AssetGroupsList" ItemsSource="{x:Bind AssetGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:AssetGroupVm">
                                    <StackPanel Spacing="2" Margin="0,4,0,4">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox
                                                MinWidth="0"
                                                VerticalAlignment="Center"
                                                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                                IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                                Checked="OnAssetGroupCheck"
                                                Unchecked="OnAssetGroupCheck" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind Title}"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{x:Bind CountText}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Grid.Column="3"
                                                Text="{x:Bind RememberText}"
                                                Visibility="{x:Bind RememberVisibility}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                VerticalAlignment="Center" />
                                            <Button
                                                Grid.Column="4"
                                                Padding="8,2"
                                                FontSize="12"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OnAssetGroupToggle"
                                                Content="{x:Bind ToggleText, Mode=OneWay}" />
                                        </Grid>

                                        <StackPanel
                                            Margin="28,0,0,0"
                                            Spacing="2"
                                            Visibility="{x:Bind ItemsVisibility, Mode=OneWay}">
                                            <ItemsControl ItemsSource="{x:Bind Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="m:AssetItemVm">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox
                                                                MinWidth="0"
                                                                VerticalAlignment="Center"
                                                                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                                                IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Text="{x:Bind DisplayName}"
                                                                VerticalAlignment="Center"
                                                                TextTrimming="CharacterEllipsis"
                                                                ToolTipService.ToolTip="{x:Bind LocalPath, Mode=OneWay}" />
                                                            <TextBlock
                                                                Grid.Column="2"
                                                                Text="{x:Bind ResolvedText}"
                                                                Visibility="{x:Bind ResolvedVisibility, Mode=OneWay}"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                VerticalAlignment="Center"
                                                                TextTrimming="CharacterEllipsis"
                                                                MaxWidth="260" />
                                                            <Button
                                                                Grid.Column="3"
                                                                Padding="8,2"
                                                                FontSize="12"
                                                                Visibility="{x:Bind BrowseVisibility}"
                                                                AutomationProperties.AutomationId="{x:Bind BrowseAutomationId}"
                                                                Click="OnAssetBrowseClick"
                                                                Content="{x:Bind BrowseText}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 批量移动分类 -->
                <Border
                    x:Name="BatchPanel"
                    Style="{StaticResource CardBorderStyle}"
                    Margin="0,0,0,16">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="BatchCountText"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            l:Trans.Text="publish.categoryLabel" />
                        <ComboBox
                            x:Name="BatchCategoryCombo"
                            Grid.Column="2"
                            MinWidth="160"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="BatchCategoryCombo" />
                        <Button
                            Grid.Column="3"
                            Click="OnBatchMoveClick"
                            AutomationProperties.AutomationId="BatchMoveButton"
                            l:Trans.Content="publish.categoryMove" />
                    </Grid>
                </Border>

                <!-- 发布 -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                    <Button
                        x:Name="PublishButton"
                        Style="{StaticResource AccentButtonStyle}"
                        MinWidth="150"
                        HorizontalContentAlignment="Center"
                        AutomationProperties.AutomationId="PublishButton"
                        Click="OnPublishClick">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <ProgressRing
                                x:Name="BusyRing"
                                IsActive="False"
                                Visibility="Collapsed"
                                Width="16"
                                Height="16" />
                            <TextBlock VerticalAlignment="Center" l:Trans.Text="publish.button" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        MaxWidth="420"
                        l:Trans.Text="publish.editHint" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>


