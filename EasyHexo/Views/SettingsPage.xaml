<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EasyHexo.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:EasyHexo.Localization">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Left">
        <StackPanel Margin="24,16,24,24" Spacing="12" MaxWidth="1000" HorizontalAlignment="Left">

            <StackPanel Spacing="2">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    l:Trans.Text="settings.title" />
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    l:Trans.Text="settings.subtitle" />
            </StackPanel>

            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />

            <!-- 语言 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        l:Trans.Text="settings.language" />
                    <ComboBox
                        x:Name="LanguageCombo"
                        MinWidth="240"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="LanguageCombo"
                        SelectionChanged="OnLanguageSelectionChanged">
                        <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                        <ComboBoxItem Content="English" Tag="en-US" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- 外观主题 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        l:Trans.Text="settings.theme" />
                    <ComboBox
                        x:Name="ThemeCombo"
                        MinWidth="240"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="ThemeCombo"
                        SelectionChanged="OnThemeSelectionChanged">
                        <ComboBoxItem Tag="system" l:Trans.Content="settings.themeSystem" />
                        <ComboBoxItem Tag="light" l:Trans.Content="settings.themeLight" />
                        <ComboBoxItem Tag="dark" l:Trans.Content="settings.themeDark" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Hexo 根目录 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        l:Trans.Text="settings.root" />
                    <TextBlock
                        x:Name="RootPathText"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        AutomationProperties.AutomationId="RootPathText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnChangeRootClick"
                            l:Trans.Content="settings.changeRoot" />
                        <Button Click="OnOpenRootClick" l:Trans.Content="settings.openFolder" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 用户配置目录（不在软件目录，升级 / 重启后保留） -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        l:Trans.Text="settings.configDir" />
                    <TextBlock
                        x:Name="ConfigDirText"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        AutomationProperties.AutomationId="ConfigDirText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Click="OnOpenConfigDirClick" l:Trans.Content="settings.openConfigDir" />
                </StackPanel>
            </Border>

            <!-- 资源管理器右键菜单 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        l:Trans.Text="settings.shellTitle" />
                    <TextBlock
                        x:Name="ShellStatusText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        AutomationProperties.AutomationId="ShellStatusText" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnRegisterShellClick"
                            AutomationProperties.AutomationId="ShellRegisterButton"
                            l:Trans.Content="settings.shellRegister" />
                        <Button
                            Click="OnRemoveShellClick"
                            AutomationProperties.AutomationId="ShellRemoveButton"
                            l:Trans.Content="settings.shellRemove" />
                    </StackPanel>
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        l:Trans.Text="settings.shellHint" />
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        l:Trans.Text="settings.about" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            l:Trans.Text="app.title" />
                        <TextBlock
                            x:Name="VersionText"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <TextBlock
                        TextWrapping="Wrap"
                        l:Trans.Text="settings.description" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            l:Trans.Text="settings.repo" />
                        <HyperlinkButton
                            Content="github.com/monishguy/easy-hexo-by-monish"
                            NavigateUri="https://github.com/monishguy/easy-hexo-by-monish"
                            Padding="4,0" />
                    </StackPanel>

                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        l:Trans.Text="settings.license" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        l:Trans.Text="settings.tech" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

