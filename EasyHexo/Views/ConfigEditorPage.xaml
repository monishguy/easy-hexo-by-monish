<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EasyHexo.Views.ConfigEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:EasyHexo.Localization"
    xmlns:m="using:EasyHexo.Models">

    <Grid Margin="20,14,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 + 操作栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="2" Margin="0,0,12,0">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    l:Trans.Text="config.title" />
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    l:Trans.Text="config.subtitle" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center">
                <Button
                    x:Name="UndoButton"
                    Click="OnUndoClick"
                    IsEnabled="False"
                    AutomationProperties.AutomationId="UndoButton"
                    l:Trans.ToolTip="common.undo">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7A7;" FontSize="12" />
                        <TextBlock l:Trans.Text="common.undo" />
                    </StackPanel>
                </Button>
                <Button Click="OnExpandAllClick" l:Trans.Content="common.expandAll" />
                <Button Click="OnCollapseAllClick" l:Trans.Content="common.collapseAll" />
                <Button Click="OnReloadClick" l:Trans.Content="common.reload" />
                <Button
                    x:Name="ApplyButton"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnApplyClick"
                    IsEnabled="False"
                    AutomationProperties.AutomationId="ApplyButton"
                    l:Trans.Content="config.apply" />
            </StackPanel>
        </Grid>

        <!-- 基本信息：最重要的信息放在最上面 -->
        <Border x:Name="HeroCard" Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="12">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        l:Trans.Text="config.hero.basic" />

                    <Grid ColumnSpacing="14" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    l:Trans.Text="config.hero.title" />
                                <TextBlock x:Name="HeroTitleDirty" Text="●" Foreground="#F59E0B" FontSize="10" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBox
                                x:Name="HeroTitleBox"
                                AutomationProperties.AutomationId="HeroTitle"
                                Tag="title"
                                MinHeight="32"
                                TextChanged="OnHeroTextChanged"
                                GotFocus="OnHeroGotFocus"
                                LostFocus="OnHeroTextLostFocus" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    l:Trans.Text="config.hero.author" />
                                <TextBlock x:Name="HeroAuthorDirty" Text="●" Foreground="#F59E0B" FontSize="10" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBox
                                x:Name="HeroAuthorBox"
                                AutomationProperties.AutomationId="HeroAuthor"
                                Tag="author"
                                MinHeight="32"
                                TextChanged="OnHeroTextChanged"
                                GotFocus="OnHeroGotFocus"
                                LostFocus="OnHeroTextLostFocus" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    l:Trans.Text="config.hero.language" />
                                <TextBlock x:Name="HeroLanguageDirty" Text="●" Foreground="#F59E0B" FontSize="10" Visibility="Collapsed" />
                            </StackPanel>
                            <ComboBox
                                x:Name="HeroLanguageCombo"
                                AutomationProperties.AutomationId="HeroLanguage"
                                Tag="language"
                                MinHeight="32"
                                HorizontalAlignment="Stretch"
                                IsEditable="True"
                                SelectionChanged="OnHeroComboSelectionChanged"
                                LostFocus="OnHeroComboLostFocus" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    l:Trans.Text="config.hero.description" />
                                <TextBlock x:Name="HeroDescriptionDirty" Text="●" Foreground="#F59E0B" FontSize="10" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBox
                                x:Name="HeroDescriptionBox"
                                AutomationProperties.AutomationId="HeroDescription"
                                Tag="description"
                                MinHeight="32"
                                TextChanged="OnHeroTextChanged"
                                GotFocus="OnHeroGotFocus"
                                LostFocus="OnHeroTextLostFocus" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    l:Trans.Text="config.hero.timezone" />
                                <TextBlock x:Name="HeroTimezoneDirty" Text="●" Foreground="#F59E0B" FontSize="10" Visibility="Collapsed" />
                            </StackPanel>
                            <ComboBox
                                x:Name="HeroTimezoneCombo"
                                AutomationProperties.AutomationId="HeroTimezone"
                                Tag="timezone"
                                MinHeight="32"
                                HorizontalAlignment="Stretch"
                                IsEditable="True"
                                SelectionChanged="OnHeroComboSelectionChanged"
                                LostFocus="OnHeroComboLostFocus" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    l:Trans.Text="config.hero.keywords" />
                                <TextBlock x:Name="HeroKeywordsDirty" Text="●" Foreground="#F59E0B" FontSize="10" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBox
                                x:Name="HeroKeywordsBox"
                                AutomationProperties.AutomationId="HeroKeywords"
                                Tag="keywords"
                                MinHeight="32"
                                TextChanged="OnHeroTextChanged"
                                GotFocus="OnHeroGotFocus"
                                LostFocus="OnHeroTextLostFocus" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Width="210" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center"
                        l:Trans.Text="config.hero.icon" />
                    <Border
                        Width="112"
                        Height="112"
                        HorizontalAlignment="Center"
                        CornerRadius="14"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Grid>
                            <FontIcon
                                x:Name="FaviconPlaceholder"
                                Glyph="&#xEB9F;"
                                FontSize="34"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Image x:Name="FaviconImage" Visibility="Collapsed" Stretch="Uniform" />
                        </Grid>
                    </Border>
                    <TextBlock
                        x:Name="FaviconValueText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        MaxWidth="210" />
                    <Button
                        x:Name="ChangeFaviconButton"
                        HorizontalAlignment="Center"
                        Click="OnChangeFaviconClick"
                        l:Trans.Content="config.favicon.change" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主题 -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="12">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        l:Trans.Text="config.theme.title" />
                    <ComboBox
                        x:Name="ThemeCombo"
                        Grid.Column="1"
                        MinWidth="150"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ThemeCombo"
                        SelectionChanged="OnThemeComboChanged" />
                    <Button
                        x:Name="SwitchThemeButton"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="SwitchThemeButton"
                        Click="OnSwitchThemeClick"
                        l:Trans.Content="config.theme.switch" />
                    <Button
                        x:Name="EditThemeConfigButton"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="EditThemeConfigButton"
                        Click="OnEditThemeConfigClick"
                        l:Trans.Content="config.theme.edit" />
                    <Button
                        x:Name="BackToSiteButton"
                        Grid.Column="4"
                        HorizontalAlignment="Left"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        AutomationProperties.AutomationId="BackToSiteButton"
                        Click="OnBackToSiteClick"
                        l:Trans.Content="config.theme.back" />
                </Grid>
                <TextBlock
                    x:Name="ThemeModeText"
                    Visibility="Collapsed"
                    TextWrapping="Wrap"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock
                    x:Name="ThemeHintText"
                    TextWrapping="Wrap"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="3"
            IsOpen="False"
            IsClosable="True"
            Margin="0,0,0,8" />

        <!-- 其它配置（分区列表） -->
        <Grid Grid.Row="4">
            <ListView
                x:Name="ConfigListView"
                AutomationProperties.AutomationId="ConfigList"
                ItemsSource="{x:Bind Rows}"
                SelectionMode="None"
                IsItemClickEnabled="False"
                ItemContainerStyle="{StaticResource ConfigListItemStyle}"
                ScrollViewer.HorizontalScrollMode="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="m:ConfigRow">
                        <Grid>
                            <Border
                                Visibility="{x:Bind SectionVisibility}"
                                Margin="0,8,0,2"
                                Padding="4,2"
                                CornerRadius="6"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Width="24"
                                        Height="24"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnSectionToggleClick">
                                        <FontIcon Glyph="{x:Bind SectionChevron}" FontSize="10" />
                                    </Button>
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind SectionTitle}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{x:Bind SectionCountText}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center"
                                        Margin="8,0,4,0" />
                                </Grid>
                            </Border>

                            <Border
                                Visibility="{x:Bind ContentVisibility}"
                                Background="{x:Bind RowBackground, Mode=OneWay}"
                                BorderBrush="{x:Bind RowBorderBrush, Mode=OneWay}"
                                BorderThickness="{x:Bind RowBorderThickness, Mode=OneWay}"
                                CornerRadius="6"
                                Padding="2,1">
                                <StackPanel Margin="{x:Bind Indent}" Padding="0,1,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            Grid.Column="0"
                                            Width="24"
                                            Height="24"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="4"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind ChevronVisibility}"
                                            IsEnabled="{x:Bind CanExpand}"
                                            Click="OnToggleExpandClick">
                                            <FontIcon Glyph="{x:Bind ChevronGlyph}" FontSize="10" />
                                        </Button>

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind Key}"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind KeyToolTip}"
                                            Margin="0,0,10,0" />

                                        <Grid Grid.Column="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBox
                                                Grid.Column="0"
                                                AutomationProperties.AutomationId="{x:Bind EditorAutomationId}"
                                                Text="{x:Bind ValueText}"
                                                Visibility="{x:Bind TextVisibility}"
                                                VerticalAlignment="Center"
                                                MinHeight="32"
                                                TextChanged="OnTextChanged"
                                                GotFocus="OnEditorGotFocus"
                                                LostFocus="OnTextLostFocus" />

                                            <ComboBox
                                                Grid.Column="0"
                                                AutomationProperties.AutomationId="{x:Bind EditorAutomationId}"
                                                Visibility="{x:Bind ComboVisibility}"
                                                VerticalAlignment="Center"
                                                MinHeight="32"
                                                HorizontalAlignment="Stretch"
                                                IsEditable="{x:Bind ComboEditable}"
                                                ItemsSource="{x:Bind ComboItems}"
                                                Text="{x:Bind ComboText}"
                                                SelectionChanged="OnComboSelectionChanged"
                                                GotFocus="OnComboGotFocus"
                                                LostFocus="OnComboLostFocus" />

                                            <ToggleSwitch
                                                Grid.Column="0"
                                                AutomationProperties.AutomationId="{x:Bind EditorAutomationId}"
                                                Visibility="{x:Bind BoolVisibility}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                IsOn="{x:Bind BoolValue}"
                                                Toggled="OnBoolToggled" />

                                            <NumberBox
                                                Grid.Column="0"
                                                AutomationProperties.AutomationId="{x:Bind EditorAutomationId}"
                                                Visibility="{x:Bind NumberVisibility}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                MinWidth="140"
                                                Value="{x:Bind NumberValue}"
                                                SpinButtonPlacementMode="Compact"
                                                ValueChanged="OnNumberValueChanged" />

                                            <TextBlock
                                                Grid.Column="0"
                                                Text="{x:Bind ValueText}"
                                                Visibility="{x:Bind StaticValueVisibility}"
                                                VerticalAlignment="Center"
                                                TextWrapping="Wrap"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                            <Button
                                                Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Padding="10,4"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind DirButtonVisibility}"
                                                Click="OnBrowseDirClick"
                                                l:Trans.Content="common.browse" />
                                        </Grid>

                                        <StackPanel
                                            Grid.Column="3"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center"
                                            Margin="8,0,0,0">
                                            <TextBlock
                                                Text="●"
                                                FontSize="12"
                                                Foreground="#F59E0B"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind DirtyDotVisibility, Mode=OneWay}" />
                                            <Border
                                                Padding="6,1"
                                                CornerRadius="4"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                                <TextBlock
                                                    Text="{x:Bind TypeText}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock
                                        Text="{x:Bind Comment}"
                                        Visibility="{x:Bind CommentVisibility}"
                                        Margin="28,2,0,2"
                                        TextWrapping="Wrap"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                x:Name="EmptyPanel"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="520"
                Spacing="12">
                <FontIcon
                    Glyph="&#xE7C3;"
                    FontSize="32"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    x:Name="EmptyMessageText"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    HorizontalAlignment="Center" />
                <Button
                    x:Name="PickRootButton"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    Click="OnPickRootClick"
                    l:Trans.Content="root.choose" />
            </StackPanel>
        </Grid>

        <TextBlock
            x:Name="StatsText"
            Grid.Row="5"
            Margin="0,8,0,0"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Page>
