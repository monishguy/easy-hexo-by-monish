<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hexo 配置易 / Easy Hexo
    =========================
    * UI 框架：WinUI 3 (Windows App SDK 1.7)
    * 运行形态：非打包（unpackaged）Win32 桌面应用，Win10 1809+ / Win11
    * 目标框架：.NET 8
    修改 Windows App SDK 版本时，只需改动下面的 PackageReference。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>EasyHexo</RootNamespace>
    <AssemblyName>EasyHexo</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <!-- 平台 -> RID，保证 F5 与 dotnet build 都能直接跑 -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>

    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- 把 Windows App SDK 运行时一起复制到输出目录，避免额外安装 Windows App Runtime -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon Condition="Exists('Assets\EasyHexo.ico')">Assets\EasyHexo.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.2.0</Version>
    <AssemblyTitle>Hexo 配置易 (Easy Hexo)</AssemblyTitle>
    <Product>Easy Hexo</Product>
    <Company>monishguy</Company>
    <Copyright>Copyright © 2026 Monishguy</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.756" />
  </ItemGroup>

</Project>

